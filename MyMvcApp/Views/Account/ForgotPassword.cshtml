@{ ViewData["Title"] = "Khôi phục mật khẩu"; }
<section class="auth-page"><div class="auth-card"><a asp-controller="Home" asp-action="Index" class="auth-logo">MOTO<span>SPEED</span></a><div class="auth-symbol"><i class="bi bi-envelope-paper"></i></div><div class="eyebrow">KHÔI PHỤC TÀI KHOẢN</div><h1>Quên mật khẩu?</h1><p class="text-secondary">Nhập email bạn đã đăng ký. Chúng tôi sẽ gửi hướng dẫn đặt lại mật khẩu.</p>@if (TempData["Notice"] is string notice) { <div class="alert alert-info">@notice</div> }<form asp-action="ForgotPassword" method="post"><div class="mb-4"><label class="form-label" for="email">Địa chỉ email</label><input class="form-control dark-input" id="email" name="email" type="email" autocomplete="email" placeholder="ban@email.com" required /></div><button class="btn btn-neon-danger w-100 rounded-pill py-3" type="submit">Gửi hướng dẫn</button></form><p class="text-center mt-4 mb-0"><a asp-action="Login" class="text-link"><i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập</a></p></div></section>
