@model IReadOnlyList<MyMvcApp.Data.MotorcycleOrder>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    string StatusLabel(string status) => status switch
    {
        "Pending" => "Chờ xác nhận",
        "Processing" => "Đang xử lý",
        "Shipping" => "Đang giao",
        "Completed" => "Hoàn tất",
        "Cancelled" => "Đã hủy",
        _ => status
    };
    string StatusClass(string status) => status switch
    {
        "Completed" => "text-bg-success",
        "Cancelled" => "text-bg-secondary",
        "Shipping" => "text-bg-info",
        _ => "text-bg-warning"
    };
}

<section class="page-heading"><div class="container"><div class="eyebrow">KHU VỰC CÁ NHÂN</div><h1>Đơn hàng <span>của tôi</span></h1><p>Theo dõi trạng thái và lịch sử đặt xe tại MOTOSPEED.</p></div></section>
<div class="container py-5">
    <div class="account-tabs"><a class="active" asp-action="Orders">Tất cả đơn hàng (@Model.Count)</a><a asp-action="Profile">Thông tin cá nhân</a><a asp-action="Saved">Xe yêu thích</a></div>
    @if (Model.Count == 0)
    {
        <div class="empty-state content-panel mt-4"><i class="bi bi-box-seam"></i><h2>Bạn chưa có đơn hàng nào</h2><p>Các đơn hàng đặt bằng email tài khoản sẽ xuất hiện tại đây.</p><a asp-controller="Motor" asp-action="Index" class="btn btn-neon-danger rounded-pill px-4">Khám phá xe</a></div>
    }
    else
    {
        <div class="account-order-list mt-4">
            @foreach (var order in Model)
            {
                <article class="content-panel account-order-card">
                    <header><div><span>MÃ ĐƠN</span><strong>#@order.OrderNumber</strong></div><div><span>NGÀY ĐẶT</span><strong>@order.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div><span class="badge @StatusClass(order.Status)">@StatusLabel(order.Status)</span></header>
                    <div class="account-order-items">
                        @foreach (var item in order.Items)
                        {
                            <div><span>@item.MotorcycleName × @item.Quantity</span><strong>@((item.UnitPrice * item.Quantity).ToString("N0")) ₫</strong></div>
                        }
                    </div>
                    <footer><span>@order.PaymentMethod · Giao đến: @order.ShippingAddress</span><strong>Tổng cộng: @order.TotalAmount.ToString("N0") ₫</strong></footer>
                </article>
            }
        </div>
    }
</div>
