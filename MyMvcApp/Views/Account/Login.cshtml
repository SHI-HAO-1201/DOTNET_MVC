@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-page">
    <div class="auth-card">
        <a asp-controller="Home" asp-action="Index" class="auth-logo">MOTO<span>SPEED</span></a>
        <div class="eyebrow mt-4">CHÀO MỪNG TRỞ LẠI</div>
        <h1>Đăng nhập</h1>
        <p class="text-secondary">Đăng nhập để theo dõi đơn hàng và nhận ưu đãi dành riêng cho bạn.</p>

        @if (TempData["Notice"] is string notice)
        {
            <div class="alert alert-info" role="status">@notice</div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <input class="form-control dark-input" id="email" name="email" type="email" autocomplete="username" placeholder="ban@email.com" required />
            </div>
            <div class="mb-2">
                <label class="form-label" for="password">Mật khẩu</label>
                <div class="password-field"><input class="form-control dark-input" id="password" name="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required /><button class="password-toggle" type="button" data-password-toggle="#password" aria-label="Hiện mật khẩu">Hiện</button></div>
            </div>
            <div class="text-end mb-4">
                <a asp-controller="Account" asp-action="ForgotPassword" class="text-link small">Quên mật khẩu?</a>
            </div>
            <button class="btn btn-neon-danger w-100 rounded-pill py-3" type="submit">
                Đăng nhập <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </form>

        <div class="auth-divider">hoặc</div>
        <button class="btn btn-outline-light w-100 rounded-pill py-2" type="button" disabled>
            <i class="bi bi-google me-2"></i>Tiếp tục với Google <small>(sắp ra mắt)</small>
        </button>
        <p class="text-center text-secondary mt-4 mb-0">
            Chưa có tài khoản? <a asp-controller="Account" asp-action="Register" class="text-link">Đăng ký ngay</a>
        </p>
        <p class="demo-note"><i class="bi bi-info-circle"></i> Quản trị viên đăng nhập ngay tại đây bằng email và mật khẩu admin đã cấu hình.</p>
    </div>
</section>
