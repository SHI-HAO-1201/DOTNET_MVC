@{ ViewData["Title"] = "Đặt hàng"; }
<section class="page-heading"><div class="container"><div class="eyebrow">BƯỚC CUỐI CÙNG</div><h1>Thông tin <span>đặt hàng</span></h1><p>Đơn hàng được lưu và nhân viên sẽ liên hệ xác nhận trước khi giao xe.</p></div></section>
<div class="container py-5"><div class="row g-4"><div class="col-lg-7"><div class="content-panel"><h2>Thông tin người nhận</h2>
@if (ViewData["OrderPlaced"] is string orderNumber) { <div class="alert alert-success" role="status">Đặt hàng thành công! Mã đơn của bạn: <strong>@orderNumber</strong>. Nhân viên sẽ sớm liên hệ xác nhận.</div> }
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<form asp-action="Checkout" method="post" id="checkout-form" data-checkout-form>
    <input type="hidden" name="cartJson" id="checkout-cart-json" />
    <div class="row g-3"><div class="col-md-6"><label class="form-label" for="fullName">Họ và tên</label><input class="form-control dark-input" id="fullName" name="fullName" autocomplete="name" required /></div><div class="col-md-6"><label class="form-label" for="phone">Số điện thoại</label><input class="form-control dark-input" id="phone" name="phone" type="tel" autocomplete="tel" pattern="[0-9+ ]{9,15}" required /></div><div class="col-12"><label class="form-label" for="email">Email</label><input class="form-control dark-input" id="email" name="email" type="email" autocomplete="email" required /></div><div class="col-12"><label class="form-label" for="address">Địa chỉ nhận xe</label><input class="form-control dark-input" id="address" name="address" autocomplete="street-address" required /></div><div class="col-md-6"><label class="form-label" for="promotionCode">Mã khuyến mãi (không bắt buộc)</label><input class="form-control dark-input" id="promotionCode" name="promotionCode" maxlength="32" /></div><div class="col-12"><label class="form-label" for="note">Ghi chú cho cửa hàng</label><textarea class="form-control dark-input" id="note" name="note" rows="3" placeholder="Thời gian nhận xe mong muốn, màu xe..."></textarea></div></div>
    <h3 class="h5 mt-4">Phương thức thanh toán</h3>@if (ViewData["PayOnDeliveryEnabled"] is not false) { <div class="payment-option"><input type="radio" name="paymentMethod" value="consult" id="payment-consult" checked /><label for="payment-consult"><i class="bi bi-headset"></i><span><strong>Nhân viên tư vấn thanh toán</strong><small>Chuyên viên liên hệ xác nhận hình thức phù hợp.</small></span></label></div> }@if (ViewData["BankTransferEnabled"] is not false) { <div class="payment-option"><input type="radio" name="paymentMethod" value="bank" id="payment-bank" /><label for="payment-bank"><i class="bi bi-bank"></i><span><strong>Chuyển khoản ngân hàng</strong><small>Thông tin thanh toán được cung cấp sau khi xác nhận.</small></span></label></div> }
    <button class="btn btn-neon-danger rounded-pill px-5 py-3 mt-4" type="submit">Gửi đơn đặt xe <i class="bi bi-arrow-right ms-2"></i></button>
</form></div></div><div class="col-lg-5"><div class="content-panel order-summary"><h2>Đơn hàng của bạn</h2><div id="checkout-items"></div><div class="summary-line"><span>Giao xe</span><strong class="text-success">Miễn phí</strong></div><hr /><div class="summary-line total"><span>Tổng cộng</span><strong id="checkout-total">0 ₫</strong></div><a asp-action="Cart" class="text-link d-block mt-3"><i class="bi bi-arrow-left me-1"></i>Quay lại giỏ hàng</a></div><div class="secure-note mt-3"><i class="bi bi-shield-lock"></i><span><strong>Đơn hàng an toàn</strong><br />Số lượng tồn kho được kiểm tra trước khi đơn hàng được xác nhận.</span></div></div></div></div>
@if (ViewData["OrderPlaced"] is string) { <script>localStorage.removeItem("motospeed-cart");</script> }
