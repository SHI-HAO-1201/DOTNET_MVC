@{ ViewData["Title"] = "Giỏ hàng"; }
<section class="page-heading"><div class="container"><div class="eyebrow">SẴN SÀNG CHO HÀNH TRÌNH MỚI?</div><h1>Giỏ hàng <span>của bạn</span></h1><p>Kiểm tra lựa chọn và thông tin trước khi tiến hành đặt hàng.</p></div></section><div class="container py-5"><div id="cart-content" class="row g-4"><div class="col-lg-8"><div class="content-panel"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="mb-0">Sản phẩm đã chọn</h2><button class="btn btn-sm btn-outline-light" id="clear-cart">Xóa giỏ hàng</button></div><div id="cart-items"></div></div></div><div class="col-lg-4"><div class="content-panel order-summary"><h2>Tóm tắt đơn hàng</h2><div class="summary-line"><span>Tạm tính</span><strong id="cart-subtotal">0 ₫</strong></div><div class="summary-line"><span>Phí giao xe</span><strong class="text-success">Miễn phí</strong></div><hr/><div class="summary-line total"><span>Tổng cộng</span><strong id="cart-total">0 ₫</strong></div><small class="text-secondary">Giá đã bao gồm VAT.</small><a class="btn btn-neon-danger w-100 rounded-pill py-3 mt-4" asp-action="Checkout">Tiến hành đặt hàng <i class="bi bi-arrow-right ms-2"></i></a><a class="text-link d-block text-center mt-3" asp-controller="Motor" asp-action="Index">Tiếp tục chọn xe</a></div></div></div><div class="empty-state content-panel d-none" id="empty-cart"><i class="bi bi-bag"></i><h2>Giỏ hàng đang trống</h2><p>Chọn chiếc xe phù hợp và bắt đầu hành trình mới của bạn.</p><a class="btn btn-neon-danger rounded-pill px-4" asp-controller="Motor" asp-action="Index">Khám phá bộ sưu tập</a></div></div>
