@model IReadOnlyList<MyMvcApp.Data.Motorcycle>
@{ ViewData["Title"] = "Mô tô và xe gắn máy"; }
<section class="page-heading"><div class="container"><div class="eyebrow">BỘ SƯU TẬP</div><h1>Mô tô dành cho <span>chất riêng</span></h1><p>Khám phá những cỗ máy được sinh ra để khơi nguồn cảm hứng trên mọi hành trình.</p><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li><li class="breadcrumb-item active">Mô tô</li></ol></nav></div></section>
<section class="container py-5"><div class="catalog-toolbar"><div><strong>@Model.Count mẫu xe</strong><span class="text-secondary ms-2">· Giá đã bao gồm VAT</span></div><select class="form-select sort-select" id="sort-products" aria-label="Sắp xếp sản phẩm"><option value="featured">Sắp xếp: Nổi bật</option><option value="price-asc">Giá tăng dần</option><option value="price-desc">Giá giảm dần</option></select></div>
<div class="row g-4"><aside class="col-lg-3"><div class="filter-panel"><h5><i class="bi bi-sliders me-2 text-danger"></i>Bộ lọc</h5><label class="form-label mt-3" for="search-products">Tìm xe</label><input id="search-products" class="form-control dark-input" placeholder="Tên xe, thương hiệu..." /><label class="form-label mt-3" for="filter-brand">Thương hiệu</label><select id="filter-brand" class="form-select dark-input"><option value="">Tất cả thương hiệu</option>@foreach (var brand in Model.Select(product => product.Brand).Distinct().OrderBy(value => value)) { <option>@brand</option> }</select><label class="form-label mt-3" for="filter-type">Dòng xe</label><select id="filter-type" class="form-select dark-input"><option value="">Tất cả dòng xe</option>@foreach (var type in Model.Select(product => product.Type).Distinct().OrderBy(value => value)) { <option>@type</option> }</select><label class="form-label mt-3" for="max-price">Khoảng giá tối đa</label><select id="max-price" class="form-select dark-input"><option value="">Không giới hạn</option><option value="150000000">150 triệu</option><option value="200000000">200 triệu</option><option value="300000000">300 triệu</option></select><button class="btn btn-outline-light w-100 mt-4" id="clear-filters" type="button">Xóa bộ lọc</button><div class="filter-help mt-4"><i class="bi bi-headset"></i><div><strong>Cần tư vấn?</strong><br /><a asp-controller="Home" asp-action="Contact">Gặp chuyên viên ngay</a></div></div></div></aside>
<div class="col-lg-9"><div class="row g-4" id="product-list">
@foreach (var bike in Model)
{
    <div class="col-md-6 col-xl-4 product-item" data-name="@bike.Name" data-brand="@bike.Brand" data-type="@bike.Type" data-price="@bike.Price" data-order="@bike.Id"><article class="product-card"><a asp-action="Details" asp-route-id="@bike.Id" class="product-image"><img src="@bike.ImageUrl" alt="@bike.Name" loading="lazy" /><span class="product-tag">CHÍNH HÃNG</span><span class="image-action"><i class="bi bi-arrow-up-right"></i></span></a><div class="product-info"><div class="product-brand">@bike.Brand · @bike.Type</div><h2><a asp-action="Details" asp-route-id="@bike.Id">@bike.Name</a></h2><div class="product-spec"><span><i class="bi bi-speedometer2"></i> @bike.Engine</span><span class="@(bike.CanBePurchased ? "text-success" : "text-secondary")">@(bike.CanBePurchased ? $"Còn hàng · {bike.StockQuantity} xe" : "Đang nhập hàng")</span></div><div class="product-bottom"><strong>@bike.Price.ToString("N0") ₫</strong>@if (bike.CanBePurchased) { <button class="add-cart" type="button" data-id="@bike.Id" data-name="@bike.Name" data-price="@bike.Price" data-image="@bike.ImageUrl" aria-label="Thêm @bike.Name vào giỏ"><i class="bi bi-bag-plus"></i></button> } else { <a href="@Url.Action("Details", new { id = bike.Id })#incoming-contact" class="btn btn-sm btn-outline-info">Để lại thông tin</a> }</div></div></article></div>
}
</div><div class="empty-state d-none" id="empty-products"><i class="bi bi-search"></i><h3>Chưa tìm thấy mẫu xe phù hợp</h3><p>Thử thay đổi từ khóa hoặc bộ lọc nhé.</p></div></div></div></section>
@section Scripts { <script>
const productCards = [...document.querySelectorAll('.product-item')];
const filterProducts = () => { const query = document.querySelector('#search-products').value.toLocaleLowerCase('vi'); const brand = document.querySelector('#filter-brand').value; const type = document.querySelector('#filter-type').value; const maxPrice = Number(document.querySelector('#max-price').value) || Infinity; let visible = 0; productCards.forEach(card => { const show = card.dataset.name.toLocaleLowerCase('vi').includes(query) && (!brand || card.dataset.brand === brand) && (!type || card.dataset.type === type) && Number(card.dataset.price) <= maxPrice; card.classList.toggle('d-none', !show); if (show) visible++; }); document.querySelector('#empty-products').classList.toggle('d-none', visible > 0); };
['#search-products','#filter-brand','#filter-type','#max-price'].forEach(selector => document.querySelector(selector).addEventListener('input', filterProducts));
document.querySelector('#clear-filters').addEventListener('click', () => { document.querySelector('#search-products').value=''; ['#filter-brand','#filter-type','#max-price'].forEach(selector => document.querySelector(selector).value=''); filterProducts(); });
document.querySelector('#sort-products').addEventListener('change', event => { const sorted = [...productCards].sort((a,b) => event.target.value === 'price-asc' ? Number(a.dataset.price)-Number(b.dataset.price) : event.target.value === 'price-desc' ? Number(b.dataset.price)-Number(a.dataset.price) : Number(a.dataset.order)-Number(b.dataset.order)); sorted.forEach(card => document.querySelector('#product-list').append(card)); });
</script> }
