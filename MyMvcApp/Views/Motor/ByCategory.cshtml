@model IReadOnlyList<MyMvcApp.Data.Motorcycle>
@{
    var brand = ViewData["Brand"] as string ?? "Mô tô";
    ViewData["Title"] = $"Xe {brand}";
    var isType = ViewData["IsType"] as bool? ?? false;
}
<section class="page-heading"><div class="container"><div class="eyebrow">SHOWROOM MOTOSPEED</div><h1>@(isType ? "Dòng xe " : "Thương hiệu ")<span>@brand</span></h1><p>Chính hãng, tư vấn tận tâm, hậu mãi an tâm trên mọi hành trình.</p><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li><li class="breadcrumb-item"><a asp-controller="Motor" asp-action="Index">Mô tô</a></li><li class="breadcrumb-item active">@brand</li></ol></nav></div></section>
<section class="container py-5"><div class="section-heading"><div><div class="eyebrow">@Model.Count MẪU XE</div><h2>Khám phá <span>@brand</span></h2></div><a asp-action="Index" class="text-link">Tất cả xe <i class="bi bi-arrow-right"></i></a></div><div class="row g-4 mt-2">@foreach (var bike in Model) { <div class="col-md-6 col-lg-4"><article class="product-card"><a class="product-image" asp-action="Details" asp-route-id="@bike.Id"><img src="@bike.ImageUrl" alt="@bike.Name"/><span class="product-tag">@bike.Type</span></a><div class="product-info"><div class="product-brand">@bike.Brand</div><h3><a asp-action="Details" asp-route-id="@bike.Id">@bike.Name</a></h3><div class="product-bottom"><strong>@bike.Price.ToString("N0") ₫</strong><a class="add-cart" asp-action="Details" asp-route-id="@bike.Id" aria-label="Xem @bike.Name"><i class="bi bi-arrow-up-right"></i></a></div></div></article></div> }</div>@if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-bicycle"></i><h3>Chúng tôi đang cập nhật bộ sưu tập</h3><p>Liên hệ để được tư vấn các mẫu xe phù hợp.</p><a asp-controller="Home" asp-action="Contact" class="btn btn-neon-danger rounded-pill">Liên hệ tư vấn</a></div> }</section>
