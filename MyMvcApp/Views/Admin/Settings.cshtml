@model MyMvcApp.Models.StoreSettingsInput
@{ ViewData["Title"] = "Cài đặt"; }
<div class="admin-page-heading"><div><div class="admin-eyebrow">THIẾT LẬP HỆ THỐNG</div><h1>Cài đặt cửa hàng</h1><p>Các cài đặt được lưu bền vững trong cơ sở dữ liệu.</p></div></div>
@if (TempData["AdminSuccess"] is string success) { <div class="alert alert-success">@success</div> }
<section class="admin-panel"><form asp-action="SaveSettings" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="admin-panel-heading"><div><h2>Thông tin cửa hàng</h2><p>Thông tin liên hệ và địa chỉ showroom.</p></div></div><div class="settings-form-grid"><label class="admin-field">Tên cửa hàng<input asp-for="StoreName" class="admin-input" /></label><label class="admin-field">Email hỗ trợ<input asp-for="SupportEmail" class="admin-input" type="email" /></label><label class="admin-field">Hotline<input asp-for="Hotline" class="admin-input" /></label><label class="admin-field">Mã số thuế<input asp-for="TaxCode" class="admin-input" /></label><label class="admin-field full-field">Địa chỉ showroom<input asp-for="Address" class="admin-input" /></label><label class="admin-field full-field">Giới thiệu cửa hàng<textarea asp-for="Description" class="admin-input" rows="3"></textarea></label></div>
<div class="admin-panel-heading mt-4"><div><h2>Thanh toán & giao hàng</h2><p>Phương thức hiển thị trong quy trình đặt xe.</p></div></div>
<label class="setting-toggle"><span><strong>Thanh toán khi nhận xe</strong><small>Cho phép khách chọn nhân viên tư vấn thanh toán.</small></span><input asp-for="PayOnDelivery" type="checkbox" /><span class="toggle-ui"></span></label><label class="setting-toggle"><span><strong>Chuyển khoản ngân hàng</strong><small>Cho phép khách chọn chuyển khoản.</small></span><input asp-for="BankTransfer" type="checkbox" /><span class="toggle-ui"></span></label><label class="setting-toggle"><span><strong>Giao xe miễn phí</strong><small>Bật chính sách giao xe miễn phí.</small></span><input asp-for="FreeDelivery" type="checkbox" /><span class="toggle-ui"></span></label>
<div class="admin-panel-heading mt-4"><div><h2>Thông báo</h2><p>Các cờ cài đặt được lưu để dùng khi tích hợp thông báo.</p></div></div><label class="setting-toggle"><span><strong>Đơn hàng mới</strong><small>Bật thông báo khi có đơn hàng mới.</small></span><input asp-for="NotifyNewOrder" type="checkbox" /><span class="toggle-ui"></span></label><label class="setting-toggle"><span><strong>Cảnh báo tồn kho thấp</strong><small>Bật cảnh báo khi tồn kho thấp.</small></span><input asp-for="NotifyLowStock" type="checkbox" /><span class="toggle-ui"></span></label><div class="d-flex justify-content-end mt-4"><button class="admin-button admin-button-primary" type="submit"><i class="bi bi-check2"></i> Lưu thay đổi</button></div></form></section>
