@model MyMvcApp.Models.AdminReviewsViewModel
@{ ViewData["Title"] = "Đánh giá"; }
<div class="admin-page-heading"><div><div class="admin-eyebrow">CHĂM SÓC TRẢI NGHIỆM</div><h1>Đánh giá khách hàng</h1><p>Đánh giá từ trang chi tiết xe; phản hồi, ẩn hoặc xóa nội dung tại đây.</p></div></div>
@if (TempData["AdminSuccess"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["AdminError"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="admin-stat-grid admin-stat-grid-compact"><div class="admin-mini-stat"><span>Điểm trung bình</span><strong>@Model.AverageRating.ToString("0.0") <span class="stars">☆☆☆☆☆</span></strong></div><div class="admin-mini-stat"><span>Tổng đánh giá</span><strong>@Model.Reviews.Count</strong></div><div class="admin-mini-stat"><span>Chờ phản hồi</span><strong class="text-warning">@Model.Statistics.PendingReviews</strong></div><div class="admin-mini-stat"><span>Đánh giá 5 sao</span><strong>@Model.FiveStarCount</strong></div></div>
<div class="admin-review-list">
@foreach (var review in Model.Reviews)
{
    <article class="admin-panel review-card"><div class="review-head"><div class="customer-cell"><span class="customer-avatar">@review.ReviewerName.Trim().Split(' ').LastOrDefault()?.FirstOrDefault()</span><span><strong>@review.ReviewerName</strong><small>@review.ReviewerEmail · @review.Motorcycle.Name · @review.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</small></span></div><span class="status-pill @(review.IsVisible ? "status-active" : "status-cancelled")">@(review.IsVisible ? "Đang hiển thị" : "Đã ẩn")</span></div><div class="stars my-3">@string.Concat(Enumerable.Repeat("★", review.Rating))@string.Concat(Enumerable.Repeat("☆", 5 - review.Rating))</div><p class="review-text">@review.Comment</p><form asp-action="SaveReviewReply" method="post" class="mb-3"><input type="hidden" name="id" value="@review.Id" /><label class="admin-label" for="reply-@review.Id">Phản hồi của cửa hàng</label><textarea class="admin-input" id="reply-@review.Id" name="adminReply" rows="2" maxlength="2000">@review.AdminReply</textarea><button class="admin-button admin-button-light mt-2" type="submit">Lưu phản hồi</button></form><div class="review-actions"><form asp-action="ToggleReviewVisibility" asp-route-id="@review.Id" method="post"><button class="admin-text-button" type="submit"><i class="bi bi-eye-slash"></i> @(review.IsVisible ? "Ẩn đánh giá" : "Hiện đánh giá")</button></form><form asp-action="DeleteReview" asp-route-id="@review.Id" method="post" onsubmit="return confirm('Xóa đánh giá này?')"><button class="admin-text-button text-danger" type="submit"><i class="bi bi-trash"></i> Xóa đánh giá</button></form></div></article>
}
@if (Model.Reviews.Count == 0) { <section class="admin-panel"><div class="admin-empty-state"><i class="bi bi-chat-square-text"></i><strong>Chưa có đánh giá</strong><span>Khách hàng có thể gửi đánh giá tại trang chi tiết mỗi mẫu xe.</span></div></section> }
</div>
