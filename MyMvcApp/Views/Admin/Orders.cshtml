@model MyMvcApp.Models.AdminOrdersViewModel
@{ ViewData["Title"] = "Đơn hàng"; var stats = Model.Statistics; }
<div class="admin-page-heading"><div><div class="admin-eyebrow">BÁN HÀNG & VẬN HÀNH</div><h1>Quản lý đơn hàng</h1><p>Đơn hàng được tạo khi khách gửi checkout và tồn kho được xác nhận.</p></div></div>
@if (TempData["AdminSuccess"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["AdminError"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="admin-stat-grid admin-stat-grid-compact"><div class="admin-mini-stat"><span>Tất cả đơn hàng</span><strong>@stats.TotalOrders</strong></div><div class="admin-mini-stat"><span>Chờ xác nhận</span><strong class="text-warning">@stats.PendingOrders</strong></div><div class="admin-mini-stat"><span>Đang giao</span><strong class="text-info">@stats.ShippingOrders</strong></div><div class="admin-mini-stat"><span>Hoàn tất</span><strong class="text-success">@stats.CompletedOrders</strong></div></div>
<div class="admin-filter-tabs"><button class="active" data-status-filter="all">Tất cả <span>@stats.TotalOrders</span></button><button data-status-filter="Pending">Chờ xác nhận <span>@stats.PendingOrders</span></button><button data-status-filter="Shipping">Đang giao <span>@stats.ShippingOrders</span></button><button data-status-filter="Completed">Hoàn tất <span>@stats.CompletedOrders</span></button><button data-status-filter="Cancelled">Đã hủy <span>@stats.CancelledOrders</span></button></div>
<section class="admin-panel"><div class="admin-toolbar"><div class="admin-search"><i class="bi bi-search"></i><input class="admin-input" type="search" placeholder="Tìm mã đơn, khách hàng, sản phẩm..." data-table-search="#orders-table" /></div></div><div class="admin-table-wrap"><table class="admin-table" id="orders-table"><thead><tr><th>Mã đơn hàng</th><th>Khách hàng</th><th>Sản phẩm</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var order in Model.Orders)
{
    var statusClass = order.Status switch { "Pending" => "status-pending", "Shipping" => "status-shipping", "Completed" => "status-completed", "Cancelled" => "status-cancelled", _ => "status-active" };
    var statusName = order.Status switch { "Pending" => "Chờ xác nhận", "Processing" => "Đang xử lý", "Shipping" => "Đang giao", "Completed" => "Hoàn tất", "Cancelled" => "Đã hủy", _ => order.Status };
    <tr data-order-status="@order.Status"><td><strong>#@order.OrderNumber</strong></td><td><strong>@order.Customer.FullName</strong><small class="table-subline">@order.Customer.Phone</small></td><td>@string.Join(", ", order.Items.Select(item => $"{item.MotorcycleName} × {item.Quantity}"))</td><td>@order.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><strong>@order.TotalAmount.ToString("N0") ₫</strong>@if (order.DiscountAmount > 0) { <small class="table-subline">Giảm @order.DiscountAmount.ToString("N0") ₫ · @order.PromotionCode</small> }</td><td>@order.PaymentMethod</td><td><span class="status-pill @statusClass">@statusName</span></td><td><div class="table-actions"><form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@order.Id" /><select name="status" class="admin-select" aria-label="Trạng thái đơn @order.OrderNumber" onchange="this.form.requestSubmit()"><option value="Pending" selected="@(order.Status == "Pending" ? "selected" : null)">Chờ</option><option value="Processing" selected="@(order.Status == "Processing" ? "selected" : null)">Xử lý</option><option value="Shipping" selected="@(order.Status == "Shipping" ? "selected" : null)">Giao</option><option value="Completed" selected="@(order.Status == "Completed" ? "selected" : null)">Hoàn tất</option><option value="Cancelled" selected="@(order.Status == "Cancelled" ? "selected" : null)">Hủy</option></select></form><form asp-action="DeleteOrder" asp-route-id="@order.Id" method="post" onsubmit="return confirm('Xóa đơn hàng #@order.OrderNumber?')"><button type="submit" aria-label="Xóa đơn @order.OrderNumber"><i class="bi bi-trash"></i></button></form></div></td></tr>
}
@if (Model.Orders.Count == 0) { <tr><td colspan="8"><div class="admin-empty-state"><i class="bi bi-receipt"></i><strong>Chưa có đơn hàng</strong><span>Doanh thu hiện tại: 0 ₫.</span></div></td></tr> }
</tbody></table></div><div class="admin-table-footer"><span>Đang hiển thị @Model.Orders.Count đơn hàng</span><span>Doanh thu: <strong>@stats.Revenue.ToString("N0") ₫</strong></span></div></section>
