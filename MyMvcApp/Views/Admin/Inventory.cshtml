@model IReadOnlyList<MyMvcApp.Data.Motorcycle>
@{ ViewData["Title"] = "Kho hàng"; var inventoryTotal = Model.Sum(product => product.StockQuantity); }
<div class="admin-page-heading"><div><div class="admin-eyebrow">TỒN KHO SHOWROOM</div><h1>Quản lý kho hàng</h1><p>Nhập số lượng thực tế và lưu cho từng mẫu xe. Tồn kho ban đầu là 0.</p></div></div>
@if (TempData["AdminSuccess"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["AdminError"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="admin-stat-grid admin-stat-grid-compact"><div class="admin-mini-stat"><span>Mã sản phẩm theo dõi</span><strong>@Model.Count</strong></div><div class="admin-mini-stat"><span>Tổng xe trong kho</span><strong>@inventoryTotal</strong></div><div class="admin-mini-stat"><span>Đã đặt trước</span><strong>0</strong></div><div class="admin-mini-stat"><span>Có thể bán</span><strong class="text-success">@inventoryTotal</strong></div></div>
<section class="admin-panel"><div class="admin-toolbar"><div class="admin-search"><i class="bi bi-search"></i><input class="admin-input" type="search" placeholder="Tìm sản phẩm trong kho..." data-table-search="#inventory-table" /></div><select class="admin-select" id="inventory-status-filter" aria-label="Lọc trạng thái kho"><option value="">Tất cả trạng thái</option><option value="ForSale">Còn hàng</option><option value="Incoming">Đang nhập hàng</option></select></div><div class="admin-table-wrap"><table class="admin-table" id="inventory-table"><thead><tr><th>Sản phẩm</th><th>Mã xe</th><th>Tồn kho</th><th>Trạng thái</th><th>Cập nhật tồn</th></tr></thead><tbody>
@foreach (var bike in Model)
{
    <tr data-availability="@bike.AvailabilityStatus"><td><div class="table-product"><img src="@bike.ImageUrl" alt="@bike.Name" /><span><strong>@bike.Name</strong><small>@bike.Brand · @bike.Type</small></span></div></td><td>@bike.Code</td><td><strong>@bike.StockQuantity</strong></td><td><span class="status-pill @(bike.CanBePurchased ? "status-active" : "status-pending")">@(bike.CanBePurchased ? "Còn hàng" : "Đang nhập hàng")</span></td><td><form asp-action="UpdateStock" method="post" class="d-flex gap-2 align-items-center"><input type="hidden" name="id" value="@bike.Id" /><input class="admin-input" type="number" name="stockQuantity" min="0" value="@bike.StockQuantity" aria-label="Tồn kho @bike.Name" style="max-width:100px" /><button class="admin-button admin-button-light" type="submit">Lưu tồn kho</button><a asp-action="EditProduct" asp-route-id="@bike.Id" class="admin-button admin-button-light">Trạng thái</a></form></td></tr>
}
</tbody></table></div><div class="admin-table-footer"><span>@Model.Count mã sản phẩm · Tổng tồn kho @inventoryTotal xe</span></div></section>
@section Scripts { <script>document.querySelector('#inventory-status-filter').addEventListener('change', event => { const status = event.target.value; document.querySelectorAll('#inventory-table tbody tr[data-availability]').forEach(row => row.classList.toggle('d-none', status && row.dataset.availability !== status)); });</script> }
