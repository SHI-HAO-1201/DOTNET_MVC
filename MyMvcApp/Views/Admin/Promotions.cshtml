@model MyMvcApp.Models.AdminPromotionsViewModel
@{ ViewData["Title"] = "Khuyến mãi"; }
<div class="admin-page-heading"><div><div class="admin-eyebrow">MARKETING & ƯU ĐÃI</div><h1>Khuyến mãi</h1><p>Tạo, chỉnh sửa hoặc xóa chương trình. Mã được lưu vào SQLite.</p></div><a asp-action="CreatePromotion" class="admin-button admin-button-primary"><i class="bi bi-plus-lg"></i> Tạo chương trình</a></div>
@if (TempData["AdminSuccess"] is string success) { <div class="alert alert-success">@success</div> }
<div class="admin-stat-grid admin-stat-grid-compact"><div class="admin-mini-stat"><span>Chương trình đang chạy</span><strong>@Model.Statistics.ActivePromotions</strong></div><div class="admin-mini-stat"><span>Mã đã sử dụng</span><strong>@Model.Statistics.PromotionUses</strong></div><div class="admin-mini-stat"><span>Giá trị ưu đãi</span><strong>@Model.Statistics.PromotionValue.ToString("N0") ₫</strong></div><div class="admin-mini-stat"><span>Tổng chương trình</span><strong>@Model.Promotions.Count</strong></div></div>
<section class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Chương trình</th><th>Mã</th><th>Mức giảm</th><th>Đã dùng</th><th>Thời hạn</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var promotion in Model.Promotions)
{
    <tr><td><strong>@promotion.Name</strong><small class="table-subline">@promotion.Description</small></td><td><strong>@promotion.Code</strong></td><td>@promotion.DiscountAmount.ToString("N0") ₫</td><td>@promotion.UsedCount / @promotion.UsageLimit</td><td>@promotion.StartsAtUtc.ToString("dd/MM/yyyy") – @promotion.EndsAtUtc.ToString("dd/MM/yyyy")</td><td><span class="status-pill @(promotion.IsActive ? "status-active" : "status-cancelled")">@(promotion.IsActive ? "Đang bật" : "Đang tắt")</span></td><td><div class="table-actions"><a asp-action="EditPromotion" asp-route-id="@promotion.Id" class="table-action-button table-action-edit"><i class="bi bi-pencil-square"></i><span>Sửa</span></a><form asp-action="DeletePromotion" asp-route-id="@promotion.Id" method="post" onsubmit="return confirm('Xóa chương trình @promotion.Code?')"><button class="table-action-button table-action-delete" type="submit"><i class="bi bi-trash3"></i><span>Xóa</span></button></form></div></td></tr>
}
@if (Model.Promotions.Count == 0) { <tr><td colspan="7"><div class="admin-empty-state"><i class="bi bi-ticket-perforated"></i><strong>Chưa có chương trình khuyến mãi</strong><span>Thêm chương trình đầu tiên để quản lý ưu đãi.</span></div></td></tr> }
</tbody></table></div></section>
