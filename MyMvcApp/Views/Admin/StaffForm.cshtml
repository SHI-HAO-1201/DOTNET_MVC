@model MyMvcApp.Models.AdminStaffInput
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm nhân viên" : "Sửa nhân viên"; }
<div class="admin-page-heading"><div><div class="admin-eyebrow">ĐỘI NGŨ CỬA HÀNG</div><h1>@ViewData["Title"]</h1></div><a asp-action="Staff" class="admin-button admin-button-light"><i class="bi bi-arrow-left"></i> Quay lại</a></div>
<section class="admin-panel"><form asp-action="SaveStaff" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="settings-form-grid"><label class="admin-field">Họ và tên<input asp-for="FullName" class="admin-input" /></label><label class="admin-field">Email công việc<input asp-for="Email" class="admin-input" type="email" /></label><label class="admin-field">Vai trò<input asp-for="Role" class="admin-input" /></label><label class="admin-field">Showroom<input asp-for="StoreLocation" class="admin-input" /></label><label class="setting-toggle"><span><strong>Tài khoản hoạt động</strong><small>Tắt nếu nhân viên không còn làm việc.</small></span><input asp-for="IsActive" type="checkbox" /><span class="toggle-ui"></span></label></div><div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Staff" class="admin-button admin-button-light">Hủy</a><button class="admin-button admin-button-primary" type="submit">Lưu nhân viên</button></div></form></section>
