@model MyMvcApp.Models.AdminCustomerInput
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm khách hàng" : "Sửa khách hàng"; }
<div class="admin-page-heading"><div><div class="admin-eyebrow">QUAN HỆ KHÁCH HÀNG</div><h1>@ViewData["Title"]</h1></div><a asp-action="Customers" class="admin-button admin-button-light"><i class="bi bi-arrow-left"></i> Quay lại</a></div>
<section class="admin-panel"><form asp-action="SaveCustomer" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="settings-form-grid"><label class="admin-field">Họ và tên<input asp-for="FullName" class="admin-input" /></label><label class="admin-field">Email<input asp-for="Email" class="admin-input" type="email" /></label><label class="admin-field">Số điện thoại<input asp-for="Phone" class="admin-input" type="tel" /></label><label class="admin-field full-field">Địa chỉ<input asp-for="Address" class="admin-input" /></label></div><div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Customers" class="admin-button admin-button-light">Hủy</a><button class="admin-button admin-button-primary" type="submit">Lưu khách hàng</button></div></form></section>
