@model MyMvcApp.Models.AdminPromotionInput
@{ ViewData["Title"] = Model.Id == 0 ? "Tạo khuyến mãi" : "Sửa khuyến mãi"; }
<div class="admin-page-heading"><div><div class="admin-eyebrow">MARKETING & ƯU ĐÃI</div><h1>@ViewData["Title"]</h1></div><a asp-action="Promotions" class="admin-button admin-button-light"><i class="bi bi-arrow-left"></i> Quay lại</a></div>
<section class="admin-panel"><form asp-action="SavePromotion" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="settings-form-grid"><label class="admin-field">Tên chương trình<input asp-for="Name" class="admin-input" /></label><label class="admin-field">Mã ưu đãi<input asp-for="Code" class="admin-input" /></label><label class="admin-field">Mức giảm (VND)<input asp-for="DiscountAmount" class="admin-input" type="number" min="0" /></label><label class="admin-field">Giới hạn lượt dùng<input asp-for="UsageLimit" class="admin-input" type="number" min="0" /></label><label class="admin-field">Ngày bắt đầu<input asp-for="StartsAt" class="admin-input" type="date" /></label><label class="admin-field">Ngày kết thúc<input asp-for="EndsAt" class="admin-input" type="date" /></label><label class="admin-field full-field">Mô tả<input asp-for="Description" class="admin-input" /></label><label class="setting-toggle"><span><strong>Kích hoạt</strong><small>Cho phép chương trình hiển thị là đang hoạt động.</small></span><input asp-for="IsActive" type="checkbox" /><span class="toggle-ui"></span></label></div><div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Promotions" class="admin-button admin-button-light">Hủy</a><button class="admin-button admin-button-primary" type="submit">Lưu chương trình</button></div></form></section>
