@model IReadOnlyList<MyMvcApp.Data.Motorcycle>
@{ ViewData["Title"] = "Mô tô chính hãng"; }
<section class="home-hero"><div class="container"><div class="hero-copy"><span class="eyebrow"><i class="bi bi-lightning-charge-fill"></i> RIDE YOUR OWN WAY</span><h1>Đánh thức<br/>bản lĩnh <span>tốc độ.</span></h1><p>Không chỉ là một chiếc xe. Đó là cảm giác tự do, là cá tính và những hành trình bạn sẽ không bao giờ quên.</p><div class="d-flex flex-wrap gap-3"><a class="btn btn-neon-danger btn-lg rounded-pill px-4" asp-controller="Motor" asp-action="Index">Khám phá bộ sưu tập <i class="bi bi-arrow-right ms-2"></i></a><a class="btn btn-outline-light btn-lg rounded-pill px-4" asp-controller="Home" asp-action="Contact"><i class="bi bi-calendar2-check me-2"></i>Đặt lịch lái thử</a></div><div class="hero-proof"><span><i class="bi bi-patch-check-fill"></i> 100% chính hãng</span><span><i class="bi bi-tools"></i> Bảo dưỡng chuẩn hãng</span><span><i class="bi bi-credit-card-2-front"></i> Trả góp linh hoạt</span></div></div></div><div class="hero-scroll">KHÁM PHÁ <i class="bi bi-arrow-down"></i></div></section>
<section class="container trust-strip"><div><strong>12+</strong><span>Năm đồng hành</span></div><div><strong>25.000+</strong><span>Khách hàng tin chọn</span></div><div><strong>18</strong><span>Thương hiệu đối tác</span></div><div><strong>4.9/5</strong><span>Đánh giá hài lòng</span></div></section>
<section class="container py-5"><div class="section-heading"><div><div class="eyebrow">CHỌN PHONG CÁCH CỦA BẠN</div><h2>Mỗi cung đường, <span>một câu chuyện</span></h2></div><a asp-controller="Motor" asp-action="Index" class="text-link">Xem tất cả xe <i class="bi bi-arrow-up-right"></i></a></div><div class="row g-4 mt-2"><div class="col-md-4"><a class="category-card category-sport" asp-controller="Motor" asp-action="ByCategory" asp-route-brand="Sportbike"><span>01 / HIỆU SUẤT</span><h3>Sportbike</h3><i class="bi bi-arrow-up-right"></i></a></div><div class="col-md-4"><a class="category-card category-naked" asp-controller="Motor" asp-action="ByCategory" asp-route-brand="Nakedbike"><span>02 / TỰ DO</span><h3>Nakedbike</h3><i class="bi bi-arrow-up-right"></i></a></div><div class="col-md-4"><a class="category-card category-cruiser" asp-controller="Motor" asp-action="ByCategory" asp-route-brand="Cruiser"><span>03 / PHONG TRẦN</span><h3>Cruiser</h3><i class="bi bi-arrow-up-right"></i></a></div></div></section>
<section class="featured-section py-5"><div class="container"><div class="section-heading"><div><div class="eyebrow">ĐƯỢC YÊU THÍCH NHẤT</div><h2>Những lựa chọn <span>nổi bật</span></h2></div><a asp-controller="Motor" asp-action="Index" class="text-link">Khám phá showroom <i class="bi bi-arrow-up-right"></i></a></div><div class="row g-4 mt-2">
@{ var featured = Model.Select(bike => new { bike.Id, bike.Name, Brand = bike.Brand.ToUpperInvariant(), Price = bike.Price.ToString("N0"), ImageUrl = bike.ImageUrl, Badge = bike.Type.ToUpperInvariant() }); }
@foreach (var bike in featured) { <div class="col-md-4"><article class="product-card"><a class="product-image" asp-controller="Motor" asp-action="Details" asp-route-id="@bike.Id"><img src="@bike.ImageUrl" alt="@bike.Name" loading="lazy"/><span class="product-tag">@bike.Badge</span></a><div class="product-info"><div class="product-brand">@bike.Brand</div><h3><a asp-controller="Motor" asp-action="Details" asp-route-id="@bike.Id">@bike.Name</a></h3><div class="product-bottom"><strong>@bike.Price ₫</strong><a class="add-cart" asp-controller="Motor" asp-action="Details" asp-route-id="@bike.Id" aria-label="Xem xe"><i class="bi bi-arrow-up-right"></i></a></div></div></article></div> }
</div></div></section>
<section class="container py-5"><div class="service-banner"><div><div class="eyebrow">MOTOSPEED CARE</div><h2>Trải nghiệm trước.<br/><span>Quyết định sau.</span></h2><p>Đặt lịch lái thử miễn phí và cảm nhận chiếc xe phù hợp nhất với bạn.</p><a class="btn btn-neon-danger rounded-pill px-4" asp-controller="Home" asp-action="Contact">Đặt lịch lái thử <i class="bi bi-arrow-right ms-2"></i></a></div><div class="service-icon"><i class="bi bi-motorcycle"></i></div></div></section>
