@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var pendingOrders = ViewData["PendingOrders"] is int pendingCount ? pendingCount : 0;
    var navItems = new[]
    {
        new { Action = "Dashboard", Label = "Tổng quan", Icon = "bi-grid-1x2" },
        new { Action = "Products", Label = "Sản phẩm", Icon = "bi-bicycle" },
        new { Action = "Orders", Label = "Đơn hàng", Icon = "bi-receipt" },
        new { Action = "Customers", Label = "Khách hàng", Icon = "bi-people" },
        new { Action = "Inventory", Label = "Kho hàng", Icon = "bi-box-seam" },
        new { Action = "ProductContactRequests", Label = "Khách chờ xe", Icon = "bi-person-lines-fill" },
        new { Action = "Promotions", Label = "Khuyến mãi", Icon = "bi-ticket-perforated" },
        new { Action = "Reviews", Label = "Đánh giá", Icon = "bi-chat-square-text" },
        new { Action = "Reports", Label = "Báo cáo", Icon = "bi-bar-chart" },
        new { Action = "Staff", Label = "Nhân viên", Icon = "bi-person-badge" },
        new { Action = "Settings", Label = "Cài đặt", Icon = "bi-gear" }
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | MOTOSPEED Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar" id="admin-sidebar">
            <a class="admin-brand" asp-controller="Admin" asp-action="Dashboard"><span class="admin-brand-mark"><i class="bi bi-speedometer2"></i></span><span>MOTO<strong>SPEED</strong><small>ADMIN PANEL</small></span></a>
            <div class="admin-store"><span class="store-dot"></span><span>Showroom chính<small>TP. Hồ Chí Minh</small></span><i class="bi bi-chevron-down ms-auto"></i></div>
            <div class="admin-nav-label">QUẢN LÝ CỬA HÀNG</div>
            <nav class="admin-nav" aria-label="Menu quản trị">
                @foreach (var item in navItems)
                {
                    var isActive = currentAction == item.Action;
                    <a class="admin-nav-link @(isActive ? "active" : null)" aria-current="@(isActive ? "page" : null)" asp-controller="Admin" asp-action="@item.Action"><i class="bi @item.Icon"></i><span>@item.Label</span>@if (item.Action == "Orders") { <span class="nav-count">@pendingOrders</span> }</a>
                }
            </nav>
            <div class="admin-sidebar-bottom"><div class="admin-demo-side"><i class="bi bi-info-circle"></i><span>Chế độ xem demo<small>Dữ liệu mẫu, chưa lưu thật</small></span></div><a class="admin-back-link" asp-controller="Home" asp-action="Index"><i class="bi bi-box-arrow-up-right"></i> Về trang cửa hàng</a></div>
        </aside>
        <div class="admin-main">
            <header class="admin-topbar"><button class="admin-menu-toggle" id="admin-menu-toggle" type="button" aria-label="Mở menu quản trị" aria-controls="admin-sidebar" aria-expanded="false"><i class="bi bi-list"></i></button><div class="admin-top-title"><span>Quản trị</span><i class="bi bi-chevron-right"></i><strong>@ViewData["Title"]</strong></div><div class="admin-top-actions"><div class="admin-user"><div class="admin-avatar">AD</div><div><strong>@User.Identity?.Name</strong><small>Administrator</small></div></div><form asp-controller="Admin" asp-action="Logout" method="post"><button class="admin-logout" type="submit" title="Đăng xuất"><i class="bi bi-box-arrow-right"></i><span>Đăng xuất</span></button></form></div></header>
            <main class="admin-content"><div class="admin-demo-alert"><i class="bi bi-database-check"></i><span><strong>Dữ liệu cửa hàng:</strong> Sản phẩm, tồn kho, đơn hàng, khách hàng, khuyến mãi và cài đặt được lưu trong cơ sở dữ liệu SQLite cục bộ.</span></div>@RenderBody()</main>
        </div>
    </div>
    <div class="admin-sidebar-backdrop" id="admin-sidebar-backdrop"></div>
    <div class="admin-toast" id="admin-toast" role="status" aria-live="polite"></div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

